# ============================================
# 企业级低代码平台 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填写实际值

# ============ 服务器配置 ============
PORT=4000
NODE_ENV=development

# 基础 URL（用于生成部署链接）
BASE_URL=http://localhost:4000

# 部署基础 URL（OSS/S3 部署后访问的基础路径）
# 如果设置了 DEPLOY_BASE_URL，部署链接将使用此地址
# DEPLOY_BASE_URL=https://your-cdn.example.com

# ============ 数据库配置 ============
DATABASE_URL="file:./dev.db"

# ============ JWT 认证配置 ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============ 外部数据库驱动 ============
# MySQL 配置（用于数据源向导）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-password
# MYSQL_DATABASE=your-database

# PostgreSQL 配置（用于数据源向导）
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=your-password
# PG_DATABASE=your-database

# ============ OSS 存储配置 ============
# 支持三种模式：aliyun（阿里云）、aws（AWS S3）、local（本地存储）
# 默认使用本地存储模式

# 存储模式选择
OSS_PROVIDER=local  # 可选值: aliyun | aws | local

# -------- 阿里云 OSS 配置 --------
# 区域（如：cn-hangzhou, cn-shanghai）
OSS_REGION=cn-hangzhou
# Bucket 名称
OSS_BUCKET=your-bucket-name
# Access Key ID
OSS_ACCESS_KEY_ID=your-access-key-id
# Access Key Secret
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 自定义 Endpoint（可选，默认使用内网 Endpoint）
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# -------- AWS S3 配置（备选）--------
# 区域（如：us-east-1, ap-southeast-1）
# AWS_REGION=us-east-1
# Bucket 名称
# AWS_S3_BUCKET=your-bucket-name
# Access Key ID
# AWS_ACCESS_KEY_ID=your-access-key-id
# Secret Access Key
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# -------- 本地存储配置 --------
# 本地部署文件存储目录（相对于项目根目录）
DEPLOY_DIR=./deploy

# ============ 文件上传配置 ============
# 文件上传大小限制（默认 10MB）
UPLOAD_MAX_SIZE=10485760
# 允许的文件类型（逗号分隔）
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============ CORS 配置 ============
# 允许的跨域来源（开发环境可使用 *）
CORS_ORIGIN=http://localhost:5173

# ============ 多租户配置（可选）===========
# 是否启用多租户模式
# MULTI_TENANT_ENABLED=false
# 默认租户 ID
# DEFAULT_TENANT_ID=

# ============ 加密配置 ============
# 用于加密敏感数据的密钥（建议使用 32 位随机字符串）
# ENCRYPTION_KEY=your-32-char-random-key-here
